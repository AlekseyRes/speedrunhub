# Django core
# Keep DEBUG off by default; set it to True only for local development.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Production security (safe defaults are applied when DJANGO_DEBUG=False).
# Override only when your deployment topology requires it.
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
DJANGO_SECURE_CONTENT_TYPE_NOSNIFF=True
DJANGO_SECURE_REFERRER_POLICY=same-origin
# Format: HEADER_NAME,header-value. Leave empty unless behind a trusted proxy.
DJANGO_SECURE_PROXY_SSL_HEADER=

# Speedrun.com API
SPEEDRUN_API_BASE_URL=https://www.speedrun.com/api/v1
SPEEDRUN_API_KEY=
SPEEDRUN_API_TIMEOUT=10
SPEEDRUN_CACHE_TTL=300
SPEEDRUN_USER_AGENT=SpeedrunHub/1.0 (Django demo; +https://www.speedrun.com)
